{
  "name": "@ai-lighthouse/cli",
  "version": "1.0.2",
  "description": "AI Lighthouse CLI - Audit websites for AI readiness",
  "type": "module",
  "bin": {
    "ai-lighthouse": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "rm -rf dist && node build.js",
    "prepublishOnly": "pnpm build",
    "check-types": "tsc --noEmit",
    "cli": "node --loader tsx src/index.ts"
  },
  "keywords": [
    "ai",
    "lighthouse",
    "audit",
    "seo",
    "accessibility",
    "llm"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ai-lighthouse/scanner": "workspace:*",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "html-pdf-node": "^1.0.8",
    "ink": "^6.6.0",
    "ink-big-text": "^2.0.0",
    "ink-box": "^2.0.0",
    "ink-gradient": "^3.0.0",
    "ink-link": "^5.0.0",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-table": "^3.1.0",
    "ink-text-input": "^6.0.0",
    "open": "^10.1.0",
    "ora": "^8.1.1",
    "react": "19.2.0",
    "react-devtools": "^7.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "esbuild": "^0.27.2",
    "tsx": "^4.21.0",
    "typescript": "5.9.2"
  }
}
